// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "Build",
    "command": "./build.sh",
    "save": "all",
    "reveal": "no_focus"
  },
  {
    "label": "Run",
    "command": "./build.sh run",
    "save": "all",
    "reveal": "no_focus",
    "env": {
      "WAYLAND_DISPLAY": "wayland-1",
      "WAYLAND_DEBUG": "1"
    }
  },
  {
    "label": "Gen",
    "command": "./gen.sh"
  }
]
